{
  "name": "broken-ice-machine",
  "version": "2.0.0",
  "description": "Self-hostable gaming social platform demo with website accounts, Discord bot commands, mini-games, wallets, and leaderboards.",
  "license": "MIT",
  "author": "Shaburger",
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node src/server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.25.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^7.2.0",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "vite": "^8.0.16",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.1",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
